import asyncio
import json
import parser

async def export_all():
    print("⏳ 1/2: Fakultetlar, kurslar va guruhlar yuklanmoqda...")
    await parser._load_all_groups_parallel()
    print(f"✅ Topilgan guruhlar soni: {len(parser._CACHED_GROUPS)} ta")
    
    print("⏳ 2/2: Barcha guruhlarning dars jadvallari yuklanmoqda (1-2 daqiqa kutasiz)...")
    raw_schedules = {}
    sem = asyncio.Semaphore(10)
    
    async def get_grp_html(gname, gid):
        async with sem:
            html = await parser.fetch_html(f"{parser.BASE_URL}/ll.php", data={"datagroupid": str(gid)})
            if html and "dars jadvali" in html.lower():
                raw_schedules[str(gid)] = html

    await asyncio.gather(*(get_grp_html(g, gid) for g, gid in parser._CACHED_GROUPS.items()))
    await parser._fetch_all_schedules()

    data = {
        "cache_struct": parser._CACHE_STRUCT,
        "cached_groups": parser._CACHED_GROUPS,
        "group_faculty_map": parser._GROUP_FACULTY_MAP,
        "all_schedules_cache": parser._ALL_SCHEDULES_CACHE,
        "raw_schedules": raw_schedules
    }

    with open("cache_data.json", "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
        
    print(f"🎉 MUVAFFAQIYATLI! 'cache_data.json' fayli yaratildi ({len(raw_schedules)} ta jadval saqlandi).")
    print("👉 Endi shu 'cache_data.json' faylini GitHub'ga yuklang!")

if __name__ == "__main__":
    asyncio.run(export_all())
